---
import type { SiteContent } from '../../content';
import Arrow from '../Arrow.astro';

interface Props { content: SiteContent }
const { content: { data, t, sections } } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="card hero-card">
    <div class="hero-main">
      <p class="eyebrow"><span class="tiny-star" aria-hidden="true">✳</span>{t('hero.eyebrow')}</p>
      <h1 id="hero-title">{data.profile.name}</h1>
      <p class="hero-role">{t('hero.role')}</p>
      <p class="hero-statement">{t('hero.statement')}</p>
      <div class="hero-actions">
        {sections.experience && <a class="button" href="#experience">{t('actions.explore')}<Arrow /></a>}
        {data.profile.resumeUrl && (
          <a class="button button-secondary" href={data.profile.resumeUrl} download aria-label={t('actions.downloadCvAccessible', { name: data.profile.name })}>
            {t('actions.downloadCv')}<Arrow diagonal />
          </a>
        )}
        <a class="text-link" href="#contact">{t('actions.getInTouch')}<Arrow diagonal /></a>
      </div>
      <p class="hero-location">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
        {t('hero.location')}
      </p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-ring art-ring--one"></div>
      <div class="art-ring art-ring--two"></div>
      <div class="art-orb art-orb--sage"></div>
      <div class="art-orb art-orb--pink"></div>
      <span class="art-spark">✳</span><span class="art-cross">+</span>
      <div class="art-note">{t('hero.note')}</div>
    </div>
  </div>
</section>
