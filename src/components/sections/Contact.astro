---
import type { SiteContent } from '../../content';
import Arrow from '../Arrow.astro';
interface Props { content: SiteContent }
const { content: { data, t } } = Astro.props;
---
<section class="container section" id="contact" aria-labelledby="contact-title"><div class="card contact-card"><div><p class="eyebrow">{t('contact.eyebrow')}</p><h2 id="contact-title">{t('contact.title')}</h2><p class="contact-description">{t('contact.description')}</p><p class="contact-location">{t(data.profile.locationKey)}</p></div><div class="contact-actions"><a class="email-address" href={`mailto:${data.profile.email}`}>{data.profile.email}<Arrow diagonal /></a><div class="contact-buttons"><a class="button" href={`mailto:${data.profile.email}`}>{t('actions.sendEmail')}<Arrow diagonal /></a><button class="button button-secondary copy-email" type="button" hidden data-email={data.profile.email} data-success={t('contact.copySuccess')} data-error={t('contact.copyError')} aria-describedby="copy-status">{t('actions.copyEmail')}</button></div><p id="copy-status" class="copy-status" role="status" aria-live="polite" aria-label={t('accessibility.emailStatus')}></p>{data.profile.resumeUrl && <a class="text-link" href={data.profile.resumeUrl} download aria-label={t('actions.downloadCvAccessible', { name: data.profile.name })}>{t('actions.downloadCv')}<Arrow diagonal /></a>}{data.profile.links.length > 0 && <ul class="profile-links">{data.profile.links.map(link => <li><a href={link.url}>{t(link.contentKey)}</a></li>)}</ul>}</div></div></section>
<script>import '../../scripts/copy-email';</script>
