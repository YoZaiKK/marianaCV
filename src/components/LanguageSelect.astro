---
import { locales, type Translator, type Locale } from '../i18n';
import { localizedPageUrl, type PageKind } from '../i18n/navigation';

interface Props { locale: Locale; t: Translator; page: PageKind }
const { locale, t, page } = Astro.props;
const id = `language-${locale}`;
---

<div class="language-select" data-language-select>
  <div class="language-fallback" role="navigation" aria-label={t('language.label')} data-language-fallback>
    {locales.map(language => (
      <a href={localizedPageUrl(language, page)} lang={language} hreflang={language} aria-label={t(`language.names.${language}`)} aria-current={language === locale ? 'page' : undefined}>
        {language.toUpperCase()}
      </a>
    ))}
  </div>
  <div data-language-control hidden>
    <span class="language-sr" id={`${id}-label`}>{t('language.label')}</span>
    <span class="language-sr" id={`${id}-help`}>{t('language.help')}</span>
    <button class="language-trigger" type="button" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-options`} aria-labelledby={`${id}-label ${id}-value`} aria-describedby={`${id}-help`}>
      <svg class="language-globe" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/></svg>
      <span class="language-current-name" id={`${id}-value`} lang={locale}>{t(`language.names.${locale}`)}</span>
      <span class="language-current-code" aria-hidden="true">{locale.toUpperCase()}</span>
      <svg class="language-chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 8 5 5 5-5"/></svg>
    </button>
    <ul class="language-options" id={`${id}-options`} role="listbox" aria-labelledby={`${id}-label`} hidden>
      {locales.map(language => (
        <li id={`${id}-option-${language}`} class="language-option" role="option" aria-selected={language === locale} data-language={language} data-href={localizedPageUrl(language, page)} data-label={t(`language.names.${language}`)}>
          <span lang={language}>{t(`language.names.${language}`)}</span>
          <span class="language-option-code" aria-hidden="true">{language.toUpperCase()}</span>
          <svg class="language-check" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .language-select { position: relative; width: 132px; flex-shrink: 0; font-family: var(--font-body); }
  .language-trigger { display: flex; width: 100%; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 10px 13px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); background: var(--surface); font: 500 12px/1.4 var(--font-body); cursor: pointer; transition: background var(--transition), border-color var(--transition); }
  .language-trigger:hover, .language-trigger[aria-expanded='true'] { background: var(--sage); border-color: #a4b293; }
  .language-trigger:focus-visible { outline: 3px solid var(--ink); outline-offset: 4px; }
  svg { stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .language-chevron { transition: transform var(--transition); }
  [aria-expanded='true'] .language-chevron { transform: rotate(180deg); }
  .language-current-code { display: none; }
  .language-options { position: absolute; z-index: 20; right: 0; top: calc(100% + 12px); width: 200px; padding: 8px; margin: 0; list-style: none; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); color: var(--ink); box-shadow: 0 12px 32px rgb(32 59 53 / 12%); }
  .language-option { display: flex; align-items: center; min-height: 48px; gap: 12px; padding: 12px; border: 1px solid transparent; border-radius: 10px; font-size: 13px; line-height: 1.5; cursor: pointer; }
  .language-option + .language-option { margin-top: 4px; }
  .language-option[aria-selected='true'] { background: var(--sage); font-weight: 600; }
  .language-option.is-active { border-color: var(--ink); background: var(--mist); }
  .language-option[aria-selected='true'].is-active { background: var(--sage); }
  .language-option-code { margin-left: auto; font-size: 10px; color: var(--muted); }
  .language-check { opacity: 0; }
  [aria-selected='true'] .language-check { opacity: 1; }
  .language-fallback { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
  .language-fallback a { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; font-size: 12px; text-decoration: none; }
  .language-fallback [aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
  .language-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 767px) {
    .language-select { width: 84px; }
    .language-trigger { padding-inline: 10px; gap: 6px; }
    .language-globe { width: 14px; height: 14px; }
    .language-current-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .language-current-code { display: inline; font-size: 11px; }
    .language-fallback { gap: 0; }
    .language-fallback a { min-width: 40px; }
  }
  @media (prefers-reduced-motion: reduce) { .language-trigger, .language-chevron { transition: none; } }
</style>

<script>import '../scripts/language-select';</script>
